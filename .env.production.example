# =============================================================================
# Venture OS Lite — PRODUCTION environment.
#
#   cp .env.production.example .env      then fill every REQUIRED value.
#
# NEVER commit the filled-in .env. Every value below that looks like a secret is
# a placeholder — replace all of them.
#
# The app validates this file at boot (src/lib/env.ts). If anything is missing
# or malformed the container refuses to start and prints exactly which variables
# are wrong, e.g.
#     Environment check failed — 2 problems:
#       ✗ MAILGUN_COLD_DOMAIN — must differ from MAILGUN_DOMAIN (both are "…")
#       ✗ NEXTAUTH_SECRET — is still the placeholder — generate a real secret
# =============================================================================


# =============================================================================
# 1. DOMAINS  (CLAUDE.md → Domain layout)
#
#   ventureco.agency         the app, at the ROOT
#   www.ventureco.agency     redirects to the root
#   audit.ventureco.agency   public website-audit reports
#   quote.ventureco.agency   public quote acceptance
#   meet.ventureco.agency    public booking page
#
# All five need an A record pointing at this server (see docs/DEPLOY.md).
# =============================================================================

# Origin the authenticated app serves from. No trailing slash, https in prod.
APP_URL=https://ventureco.agency

# Public surfaces. Each must be its own origin — boot fails if any two match.
PUBLIC_AUDIT_URL=https://audit.ventureco.agency
PUBLIC_QUOTE_URL=https://quote.ventureco.agency
PUBLIC_MEET_URL=https://meet.ventureco.agency

# Bare hostnames (no scheme) — Caddy uses these to request TLS certificates.
APP_HOST=ventureco.agency
WWW_HOST=www.ventureco.agency
PUBLIC_AUDIT_HOST=audit.ventureco.agency
PUBLIC_QUOTE_HOST=quote.ventureco.agency
PUBLIC_MEET_HOST=meet.ventureco.agency

# Where Let's Encrypt sends certificate-expiry warnings. Use a real inbox.
ACME_EMAIL=director@ventureco.group


# =============================================================================
# 2. DATABASE — Postgres 16 in the `db` container
# =============================================================================

# postgres | mysql. Production is postgres: it is the only flavour with
# row-level security, and boot rejects anything else.
DB_FLAVOR=postgres

# Superuser credentials for the db container. Invent long random values —
# nothing outside the Docker network ever connects with them.
POSTGRES_USER=venture
POSTGRES_PASSWORD=CHANGE-ME-long-random-db-password
POSTGRES_DB=ventureos

# Password for `app_user`, the NOSUPERUSER NOBYPASSRLS role the app and worker
# actually connect as. A superuser would silently bypass every RLS policy, so
# this role is what makes database-level tenancy real. Invent another long
# random value; scripts/apply-rls.ts creates the role with it on first boot.
APP_DB_PASSWORD=CHANGE-ME-long-random-app-role-password

# Connection string. docker-compose.prod.yml overrides this per service (app and
# worker as app_user, the one-shot migrate job as the superuser), so the value
# here is only used when running commands by hand outside compose.
DATABASE_URL=postgresql://app_user:CHANGE-ME-long-random-app-role-password@db:5432/ventureos?schema=public


# =============================================================================
# 3. JOBS & CACHE
# =============================================================================

# Redis for BullMQ (follow-up timers, audits, PDFs, digests, sweeps).
# Compose overrides this to the in-network host; leave as-is.
REDIS_URL=redis://redis:6379


# =============================================================================
# 4. AUTH  (Auth.js / NextAuth)
# =============================================================================

# Session-signing secret. Generate with:  openssl rand -base64 32
# Boot refuses any value under 32 characters or still starting with "change-me".
NEXTAUTH_SECRET=CHANGE-ME-run-openssl-rand-base64-32

# Must equal APP_URL in production.
NEXTAUTH_URL=https://ventureco.agency

# Auth.js v5's own name for the signing secret. Leave this commented out — the
# app reads AUTH_SECRET first and falls back to NEXTAUTH_SECRET above, so set
# only ONE of them. Uncomment only if you prefer the Auth.js-native name.
# AUTH_SECRET=CHANGE-ME-run-openssl-rand-base64-32


# =============================================================================
# 5. ANTHROPIC  (server-side only — never exposed to the browser)
# =============================================================================

# Claude API key. Get it at console.anthropic.com → Settings → API keys.
# Starts with "sk-ant-". Per-workspace daily USD caps are set in the app's
# Settings screen, not here.
ANTHROPIC_API_KEY=sk-ant-CHANGE-ME


# =============================================================================
# 6. EMAIL — TWO SEPARATE MAILGUN SETUPS
#
# Transactional and cold outreach run on different domains with different
# credentials, so a cold-list complaint can never damage the reputation that
# quotes, contracts and booking confirmations depend on. This is enforced in
# code (src/modules/mail/provider.ts), not just here: boot fails if the two
# domains match, and a cold send is refused outright if it would go out on the
# transactional domain or with the transactional key.
# =============================================================================

# mailgun | mock. Production is mailgun; mock only logs to stdout.
MAIL_PROVIDER=mailgun

# Keep data in the Mailgun EU region (GDPR). Must be true in production.
MAILGUN_EU=true

# ---- 6a. TRANSACTIONAL: quotes, contracts, certificates, confirmations ------
# Already-verified sending domain. Mailgun → Sending → Domains.
MAILGUN_DOMAIN=mg.ventureco.group
# Sending API key for THAT domain. Mailgun → Sending → Domain settings →
# Sending API keys → Add sending key.
MAILGUN_API_KEY=CHANGE-ME-transactional-sending-key
# Verifies delivery/open/bounce webhooks are really from Mailgun.
# Mailgun → Settings → Webhooks → HTTP webhook signing key.
MAILGUN_WEBHOOK_SIGNING_KEY=CHANGE-ME-webhook-signing-key

# ---- 6b. COLD OUTREACH: the compliance-gated campaign module ----------------
# A SEPARATE verified domain — never the transactional one. Add and verify it
# in Mailgun exactly like 6a, with its own SPF/DKIM records.
MAILGUN_COLD_DOMAIN=cold.ventureco.agency
# Its OWN sending key. Reusing MAILGUN_API_KEY here fails the boot check.
MAILGUN_COLD_API_KEY=CHANGE-ME-cold-sending-key


# =============================================================================
# 7. PROSPECTING & AUDITING
# =============================================================================

# Google Places API (New) key — Prospector search. console.cloud.google.com →
# APIs & Services → Credentials. Enable "Places API (New)" and restrict the key
# to this server's IP.
GOOGLE_PLACES_API_KEY=CHANGE-ME-google-places-key

# PageSpeed Insights API key — website audit performance scores. Same Google
# Cloud project; enable "PageSpeed Insights API". May be left blank: audits
# still run, without Lighthouse scores.
PAGESPEED_API_KEY=CHANGE-ME-pagespeed-key

# Chrome UX Report API key — real-visitor field data beside the lab score.
# OPTIONAL: leave blank and the PageSpeed key is reused, which is right when
# both APIs live in the same Google Cloud project. Enable "Chrome UX Report
# API" there. With neither key, audits simply report no field data.
CRUX_API_KEY=


# SERP provider credential ("login:password") for weekly rank tracking.
# OPTIONAL and off by default: without it the feature is dormant. We never
# scrape Google — every position is a billed API query, and the app shows the
# projected monthly cost before you enable tracking.
SERP_CREDENTIAL=


# =============================================================================
# 8. MEETINGS — Google Calendar OAuth
# =============================================================================

# google | mock. mock keeps booking working with no calendar write.
CALENDAR_PROVIDER=google
# Google Cloud → APIs & Services → Credentials → OAuth 2.0 Client ID (Web).
GOOGLE_CLIENT_ID=CHANGE-ME.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=CHANGE-ME-google-oauth-secret
# Must be listed verbatim as an Authorized redirect URI on that OAuth client.
GOOGLE_REDIRECT_URI=https://ventureco.agency/api/google/callback


# =============================================================================
# 9. HUNGARIAN BUSINESS INTEGRATIONS
# =============================================================================

# cegadat | mock — company-registry enrichment, adószám dedupe and the outbound
# motor's datasheets (spec §4.19, §4.43.4). With a Cégadat key configured
# (here or, preferably, Settings → Integrations) the key wins and this is
# ignored; `mock` serves a handful of built-in fixture companies for
# development and is refused in production.
REGISTRY_PROVIDER=cegadat
# Cégadat API key (cegadatapi.hu, Haladó plan: unlimited search, 5,000 detail
# lookups a month). The documentation publishes a test key that answers for
# six real companies — usable for development, not for prospecting.
CEGADAT_API_KEY=

# mock | szamlazz — invoicing. The per-workspace Számla Agent key is entered in
# the app's Settings screen (encrypted at rest), not here.
SZAMLAZZ_PROVIDER=szamlazz


# =============================================================================
# 10. STORAGE
# =============================================================================

# ---- CREDENTIAL ENCRYPTION -------------------------------------------------
# Encrypts the API keys stored per workspace in Settings → Integrations
# (AES-256-GCM). Generate with:  openssl rand -base64 32
# Losing or changing this makes every stored integration secret unreadable —
# they fall back to the env values below until re-entered. Never editable from
# the UI: it is what protects everything that IS.
CREDENTIALS_KEY=CHANGE-ME-run-openssl-rand-base64-32

# ---- STORAGE ---------------------------------------------------------------
# Absolute path for generated PDFs, audit screenshots and GDPR exports. Backed
# by the `files` Docker volume and included in the nightly backup. Compose sets
# this per container; do not change it.
FILES_DIR=/data/files

# Which workspace receives leads from the PUBLIC self-serve audit page
# (audit.<domain>). Only needed when more than one workspace exists: with a
# single workspace the app resolves it automatically. Left unset on a
# multi-workspace install, public intake refuses rather than guessing which
# tenant an inbound lead belongs to.
# PUBLIC_INTAKE_WORKSPACE_ID=


# =============================================================================
# 11. FIRST-RUN SEED  (optional)
# =============================================================================

# Email of the first Owner created by `npm run db:seed`. See docs/DEPLOY.md for
# creating the Owner and setting a password.
SEED_OWNER_EMAIL=director@ventureco.group


# =============================================================================
# 12. BACKUPS  (optional — read by scripts/backup.sh, not by the app)
# =============================================================================

# Where nightly dumps are written.
BACKUP_DIR=/var/backups/ventureos
# Days of backups to keep. Do not raise without revisiting the GDPR erasure
# promise in CLAUDE.md — an erased lead must disappear from backups too.
RETENTION_DAYS=14


# =============================================================================
# 13. ESCAPE HATCH — leave unset in production
# =============================================================================

# Set to 1 to skip the boot-time env check. Only for debugging a container that
# will not start; a running production stack must never have this set.
# SKIP_ENV_VALIDATION=1

# ---- Web Push (playbook-v2 P6/1) -------------------------------------------
# Optional. With no keys, push is unavailable and Settings > Notifications says
# so; every notification still reaches the in-app bell. Generate a pair with
# `npm run vapid`. Both keys are required together - half a pair lets a browser
# subscribe successfully and then never receive anything.
# Rotating them invalidates every stored subscription, because a browser's
# subscription is bound to the public key it was created with.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for the push service. mailto: or an https: URL; defaults to APP_URL.
VAPID_SUBJECT=

# =============================================================================
# =============================================================================
# 13b. NAV ONLINE SZÁMLA — free, official Hungarian company data
# =============================================================================
# Replaces a paid company-registry subscription. queryTaxpayer is READ-ONLY and
# free; it returns a company's legal name, registered seat and taxpayer status
# from the NAV register.
#
# Preferably configure these in the app (Settings → Integrations) rather than
# here: values stored there are encrypted at rest and take precedence over these.
#
# ⚠ IF A SECRET CONTAINS A DOLLAR SIGN, ESCAPE IT AS \$
#   The env loader treats $NAME as a reference to another variable and expands
#   it to nothing. A password like  ab?$xyzPQ123@  silently becomes  ab?@  —
#   four characters — and NAV answers "invalid technical user" with no hint why.
#   This cost a real debugging round. Escape it, or set it in Settings and leave
#   this blank.
#
# Where the values come from: onlineszamla.nav.gov.hu → a Primary User creates a
# technical user; the system generates the login and the keys, you choose the
# password. The test system (onlineszamla-test.nav.gov.hu) is a SEPARATE
# registration with its own technical user.
NAV_ENV=production
NAV_LOGIN=
NAV_PASSWORD=
NAV_SIGN_KEY=
# Not needed for company lookup — only for future invoice reporting.
NAV_EXCHANGE_KEY=
# Your own company's first 8 tax digits, no dashes.
NAV_TAX_NUMBER=
# Exactly 18 characters. Self-declared: NAV requires it but does not issue it.
NAV_SOFTWARE_ID=

# 14. DEVELOPER TOOLING — never set in production
# =============================================================================
# These are read only by scripts in scripts/, never by the app. They exist so a
# performance run can be made smaller or repeated more times without editing
# code (playbook-v2 P6/3).

# How many rows `npm run seed:scale` creates. Defaults: 5000 leads, 2000 deals.
# SCALE_LEADS=5000
# SCALE_DEALS=2000

# How many timed runs `npm run perf` takes per interaction before reporting the
# median. Defaults to 7.
# PERF_RUNS=7
# Cards per column the pipeline-board measurement asks for, so the run can be
# compared against the pre-cap behaviour. 0 means "no cap". Defaults to 25.
# PERF_STAGE_CAP=25

# ── E-mail-cím ellenőrző (opcionális, playbook-v3 P9/2) ─────────────────────
# Csak hideg kampányhoz kell, és akkor sem kötelező. Nélküle is fut minden
# beépített ellenőrzés: helyesírás, eldobható postafiók, szerep-cím, MX-rekord.
# Ez a kulcs annyit tesz hozzá, hogy a postafiók létezését is megerősíti,
# címenként pár tized centért. Üresen hagyva SEMMI nem megy ki külső
# szolgáltatóhoz. Workspace-enként felülírható: Beállítások → Integrációk.
VERIFIER_API_KEY=

# ── Row-level security (CLAUDE.md hard rule #1) ─────────────────────────────
# "on"  → workspace-scoped queries run as the non-superuser role `app_user`,
#         and Postgres refuses cross-workspace rows even if the Prisma tenant
#         guard were removed. This is the second belt the hard rule promises.
# "off" → guard only (the behaviour before this was wired). Default.
#
# Requires APP_DB_PASSWORD to match the role the migrate step created. Turning
# it on is a deliberate act: verify with `npm run test -- rls-isolation` against
# the target database first.
DB_RLS=off
