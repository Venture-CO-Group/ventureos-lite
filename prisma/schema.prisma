// Venture OS Lite — Prisma schema (spec §8: v1.0 + v1.1 entities).
//
// PORTABILITY (CLAUDE.md): the schema runs on Postgres 16 and MySQL 8. To stay
// portable we avoid Postgres-only column types:
//   - no scalar lists (String[]) — MySQL can't do them; array-ish data is Json
//   - long free text is @db.Text (valid native type on both connectors)
//   - USD amounts are Decimal, HUF is integer forints (Int), never floats
// Switch `provider` to "mysql" when DB_FLAVOR=mysql (and point DATABASE_URL at
// MySQL). Columns/tables are snake_cased via @map so the RLS SQL lines up.
//
// TENANCY (CLAUDE.md hard rule #1): every business table carries workspace_id
// and is scoped by the mandatory tenant guard (src/lib/tenant-guard.ts). On
// Postgres, RLS policies keyed to membership add DB-level enforcement.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // set to "mysql" when DB_FLAVOR=mysql
  url      = env("DATABASE_URL")
}

// ============================================================================
// Enums (portable across postgres + mysql)
// ============================================================================

enum Role {
  OWNER
  ADMIN
  BDR
}

enum LeadSource {
  PROSPECTOR
  LINKEDIN
  MANUAL
  REFERRAL
  COLD_EMAIL
  /// Came to us: ran their own audit on the public landing and asked for the
  /// report (P12/1c). The warmest source there is, and the only one where the
  /// lawful basis for contacting them is a consent record.
  SELF_SERVE_AUDIT
}

enum Stage {
  RESEARCHED
  CONTACTED
  ACCEPTED
  REPLIED
  QUALIFIED
  MEETING_BOOKED
  HANDED_OFF
  NOT_NOW
  DISQUALIFIED
}

enum Lang {
  HU
  EN
}

enum TemplateType {
  QUOTE
  CONTRACT
  CERTIFICATE
  EMAIL
}

enum TemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum DocumentType {
  QUOTE
  CONTRACT
  CERTIFICATE
}

enum DocumentStatus {
  DRAFT
  SENT
  ACCEPTED
  DECLINED
  EXPIRED
  SIGNED
  ACKNOWLEDGED
}

enum EmailStatus {
  QUEUED
  DELIVERED
  OPENED
  BOUNCED
  FAILED
}

enum CallOutcome {
  NO_ANSWER
  CALLBACK_REQUESTED
  INTERESTED
  NOT_INTERESTED
  WRONG_NUMBER
}

enum CampaignStatus {
  DRAFT
  PAUSED
  ACTIVE
  COMPLETED
  DISABLED
}

enum ReferrerKind {
  PERSON
  COMPANY
}

enum DealResult {
  WON
  LOST
  POSTPONED
}

/// Where a deal stands in the money journey (v2 P4).
///
/// Separate from the stage it sits in: a pipeline may have several terminal
/// stages, and "is this deal still live?" must be answerable without knowing
/// the workspace's own stage names.
enum DealStatus {
  OPEN
  WON
  LOST
}

enum InvoiceStatus {
  PREPARED
  SUBMITTED
  ISSUED
  PAID
  /// Money that came in and went back out (P11/1d). A separate status rather
  /// than deleting the row: the commission ledger has to see the reversal to
  /// offset it, and a deleted invoice is a payment that silently never happened.
  REFUNDED
  FAILED
}

/// Where a company sits in the client lifecycle (playbook-v3 P11/1a).
enum ClientStatus {
  PROSPECT
  CLIENT
  /// Was a client; every subscription has since churned.
  FORMER
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CHURNED
}

enum AuditVerdict {
  STRONG
  POSSIBLE
  SKIP
}

enum MessageDirection {
  OUTBOUND
  INBOUND
}

enum MessageChannel {
  LINKEDIN
  EMAIL
  COLD_EMAIL
}

enum MessageStatus {
  DRAFT
  SENT
  FAILED
}

/// The shape of an Owner-defined field (playbook-v2 P5/1).
enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTISELECT
  CHECKBOX
  URL
}

enum FrameStatus {
  DRAFT
  PROPOSED
  APPROVED
  ARCHIVED
}

enum InsightKind {
  DAILY
  WEEKLY
}

// ============================================================================
// Global (NOT tenant-scoped): identity + tenancy mapping. No workspace_id.
// These are excluded from the tenant guard; RLS restricts them to the acting
// user / their memberships.
// ============================================================================

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String
  passwordHash        String               @map("password_hash")
  totpSecret          String?              @map("totp_secret") // base32, set at enrollment
  totpEnabled         Boolean              @default(false) @map("totp_enabled")
  /// Consumed TOTP step, so a code cannot be replayed inside its 30s window.
  totpLastStep        Int?                 @map("totp_last_step")
  lockedUntil         DateTime?            @map("locked_until")
  /// Consecutive lockouts in the current run of failures (v2 P6/2). Selects the
  /// backoff step; reset to 0 the moment a login succeeds, because the run is
  /// over when somebody gets in.
  lockCount           Int                  @default(0) @map("lock_count")
  lastLoginAt         DateTime?            @map("last_login_at")
  /// Forces a password change on next login (seeded/reset accounts).
  mustChangePassword  Boolean              @default(false) @map("must_change_password")
  /// Set when an Owner resets someone's 2FA: the old secret is gone and they
  /// must scan a fresh QR before they can use the app again.
  mustEnrollTotp      Boolean              @default(false) @map("must_enroll_totp")
  /// When this person finished (or dismissed) the first-login tour (v2 P7/4).
  /// On the User rather than on the Membership: a tour teaches the PRODUCT, and
  /// someone added to a second workspace has already seen it.
  tourSeenAt          DateTime?            @map("tour_seen_at")
  /// When they dismissed the getting-started checklist by hand. It also hides
  /// itself once every item is done; this is for the person who does not want
  /// it either way.
  checklistHiddenAt   DateTime?            @map("checklist_hidden_at")
  /// Their own photo, under FILES_DIR as `user-avatars/<id>.<ext>`. On the User
  /// rather than the Membership: it is a picture of a person, and someone in two
  /// workspaces is the same person in both.
  avatarPath          String?              @map("avatar_path")
  /// PLATFORM operator, not a workspace role.
  ///
  /// Role (OWNER/ADMIN/BDR) is per membership and says what someone may do
  /// INSIDE a workspace. This says they administer the installation itself, and
  /// it is deliberately not grantable from the UI: an Owner who could hand it
  /// out could hand it to themselves. It is set by
  /// `scripts/set-super-admin.ts`, on the server, by whoever has the shell.
  isSuperAdmin        Boolean              @default(false) @map("is_super_admin")
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  memberships         Membership[]
  sessions            Session[]
  googleCredentials   GoogleCredential[]
  captureTokens       CaptureToken[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

// Global (per-user) Google OAuth tokens for Calendar (spec §4.8). Not tenant-scoped.
/// One connected Google account. A host may connect several — typically a
/// business account that meetings are written to, plus a personal one that
/// only contributes busy times so nobody books over a dentist appointment.
model GoogleCredential {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  /// Which Google account this is, for the UI and to keep reconnects idempotent.
  accountEmail String?   @map("account_email")
  /// WRITE = meetings are created here (exactly one per host).
  /// BUSY_ONLY = read for availability, never written to.
  purpose      String    @default("WRITE")
  accessToken  String    @map("access_token")
  refreshToken String?   @map("refresh_token")
  expiryDate   DateTime? @map("expiry_date")
  scope        String?
  calendarId   String?   @map("calendar_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// Reconnecting the same Google account updates it rather than duplicating.
  @@unique([userId, accountEmail])
  @@index([userId])
  @@map("google_credentials")
}

/// Server-side session (CLAUDE.md → Auth). The browser cookie only carries an
/// opaque token; the row here is authoritative, so a session can be revoked
/// server-side and survives no client state. `token` stores a SHA-256 hash —
/// a database leak must not hand out usable sessions.
model Session {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  token       String    @unique // sha256(opaque token), never the token itself
  workspaceId String?   @map("workspace_id") // active workspace for this session
  ip          String?
  userAgent   String?   @map("user_agent")
  expiresAt   DateTime  @map("expires_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One-time password-reset link issued by an Owner. Only a SHA-256 hash is
/// stored, so a database leak yields no usable links; single-use and short-lived.
model PasswordResetToken {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  token           String    @unique // sha256(raw token)
  expiresAt       DateTime  @map("expires_at")
  usedAt          DateTime? @map("used_at")
  createdByUserId String?   @map("created_by_user_id")
  createdAt       DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

/// Login attempt ledger, used for rate limiting and lockout (CLAUDE.md → Auth:
/// "rate-limited login"). Keyed by email AND by IP so neither a single account
/// nor a single source can be hammered. Pruned by the retention sweep.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ip        String?
  ok        Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@map("login_attempts")
}

model Membership {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  workspaceId String    @map("workspace_id")
  role        Role      @default(BDR)
  grants      Json      @default("[]") // string[] of capability grants (portable as Json)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Workspace {
  id            String       @id @default(cuid())
  name          String
  legalName     String?      @map("legal_name")
  brand         Json?        @map("brand_json")
  mailgunConfig Json?        @map("mailgun_config")
  icpConfig     Json?        @map("icp_config")
  auditConfig   Json?        @map("audit_config") // verdict thresholds + check weights
  /// Deals layer settings (v2 P4/c): { commitThreshold } — the probability at
  /// or above which forecast weight counts as commit rather than upside.
  dealsConfig   Json?        @map("deals_config")
  claudeBudget  Decimal      @default(2) @map("claude_budget") // USD daily cap
  retentionDays Int          @default(365) @map("retention_days")
  featureFlags  Json?        @map("feature_flags")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  memberships   Membership[]

  @@map("workspaces")
}

// ============================================================================
// Business (tenant-scoped): every table has workspace_id + an index on it.
// ============================================================================

model Company {
  id            String       @id @default(cuid())
  workspaceId   String       @map("workspace_id")
  name          String
  domain        String?
  website       String?
  industry      String?
  sizeBand      String?      @map("size_band")
  phone         String?
  address       String?
  city          String?
  taxId         String?      @map("tax_id") // adószám — dedupe key within a workspace
  /// Google's own id for the place this company was prospected from. The only
  /// EXACT dedupe key the Prospector has: a business with neither a website nor
  /// a phone number — and there are plenty — matched nothing before, so it could
  /// be added twice with no duplicate warning at all.
  googlePlaceId String?      @map("google_place_id")
  /// How this company entered the workspace, when it was not a prospect we
  /// chose: "competitor_audit" for one pulled in by a comparison (P2/3). Null
  /// for everything created the ordinary way.
  source        String?
  notes         String?      @db.Text
  /// Client lifecycle (playbook-v3 P11/1a). The playbook promotes a company on
  /// "first deal won"; there is no Deal model yet (v2 P4 is not started), so
  /// promotion happens on the first thing that means the same in practice — a
  /// subscription starting, or an invoice being paid. When Deal arrives it
  /// becomes a third trigger rather than a replacement.
  clientStatus  ClientStatus @default(PROSPECT) @map("client_status")
  clientSince   DateTime?    @map("client_since")
  /// Manual "something is wrong here" toggle. One of the four health inputs,
  /// and the only one a person sets by hand (P11/1c).
  supportFlag   Boolean      @default(false) @map("support_flag")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  leads         Lead[]
  audits        AuditResult[]
  auditWatch    AuditWatch?
  keywords      TrackedKeyword[]
  logUploads    LogUpload[]
  registry      RegistryData?
  referrers     Referrer[]
  /// Homepage prose, fetched once and cached for 30 days (P1/1c). Feeds the
  /// research prompt so Claude has the company's own words rather than three
  /// fields. Null when the site is unreachable or robots.txt forbids it.
  siteText      String?          @map("site_text") @db.Text
  /// When the fetch was last ATTEMPTED — set even on failure, so a dead site
  /// is not re-fetched on every research run.
  siteFetchedAt DateTime?        @map("site_fetched_at")
  invoices      Invoice[]
  subscriptions Subscription[]
  deals         Deal[]
  /// Owner-defined field values (P5/1). See Lead.customFields.
  customFields  Json?            @map("custom_fields")
  /// Set when this company was merged INTO another (P5/2). The row is kept as a
  /// tombstone rather than deleted, so a bookmarked link, a stale tab or an
  /// external system's stored id still resolves — to the survivor.
  mergedIntoId  String?          @map("merged_into_id")
  mergedAt      DateTime?        @map("merged_at")
  /// The import that created or last touched this row (P5/3).
  importBatchId String?          @map("import_batch_id")

  @@unique([workspaceId, taxId])
  @@index([workspaceId])
  @@index([workspaceId, googlePlaceId])
  @@map("companies")
}

model Lead {
  id                 String     @id @default(cuid())
  workspaceId        String     @map("workspace_id")
  companyId          String?    @map("company_id")
  referrerId         String?    @map("referrer_id")
  contactName        String?    @map("contact_name")
  title              String?
  /// The LinkedIn headline — free prose the person wrote about themselves, e.g.
  /// "VP Sales @ Metaview | Startup Advisor and Investor". Its OWN column, not a
  /// fallback for `title`: the capture used to collapse the two, so a profile with
  /// no Experience section got its headline filed as its job title and the form
  /// rendered it in the job-title input beside an empty Name field.
  headline           String?    @db.Text
  /// The location line exactly as LinkedIn showed it — "San Francisco Bay Area",
  /// "Miskolc és környéke". Kept RAW and always, even when the gazetteer cannot
  /// resolve a city out of it: the string was on the profile, an operator can read
  /// it, and discarding it was how a captured location became a blank field.
  locationRaw        String?    @map("location_raw")
  email              String?
  /// Email verification (playbook-v3 P9/2): valid | risky | invalid | unknown.
  /// Held on the CONTACT rather than on the campaign, so an address checked for
  /// one campaign is not re-checked — and re-paid for — by the next.
  emailStatus        String?    @map("email_status")
  /// Why, in the verifier's own vocabulary. Rendered through REASON_TEXT.
  emailReason        String?    @map("email_reason")
  /// Stale after 90 days: a domain that resolved in spring is not evidence
  /// about autumn.
  emailCheckedAt     DateTime?  @map("email_checked_at")
  phone              String?
  linkedinUrl        String?    @map("linkedin_url")
  source             LeadSource @default(MANUAL)
  /// Who works this lead (playbook-v2 P3/2 — a filter field and a bulk action).
  /// A plain column rather than a relation, like Activity.byUserId and
  /// Task.assigneeId: users are global and leads are tenant-scoped, so a real
  /// foreign key would tie a business table to the identity tables across the
  /// tenancy boundary. Null means unassigned, which is a state worth filtering
  /// FOR ("nobody owns these") rather than hiding.
  ownerId            String?    @map("owner_id")
  /// Language to write to this contact in. Feeds the outreach drafter, which
  /// previously always assumed Hungarian.
  language           Lang       @default(HU)
  /// How the language was decided: "high" / "medium" / "low" from detection, or
  /// "manual" once a human has chosen. The default alone was the bug — every lead
  /// inherited the workspace's language, so an English profile in California came
  /// out Hungarian and its outreach draft would have been written in Hungarian.
  /// "manual" is never overwritten by a later capture.
  languageConfidence String?    @map("language_confidence")
  stage              Stage      @default(RESEARCHED)
  stageEnteredAt     DateTime   @default(now()) @map("stage_entered_at")
  stageReason        String?    @map("stage_reason")
  icpScore           Int?       @map("icp_score")
  scoreBreakdown     Json?      @map("score_breakdown")
  signals            Json       @default("[]") // string[] of trigger signals
  qualification      Json? // { authority, history, budget, timeline } booleans
  escalatedAt        DateTime?  @map("escalated_at")
  notes              String?    @db.Text
  wakeUpAt           DateTime?  @map("wake_up_at")
  lastActivityAt     DateTime?  @map("last_activity_at")
  anonymizedAt       DateTime?  @map("anonymized_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  referrer      Referrer?     @relation(fields: [referrerId], references: [id], onDelete: SetNull)
  activities    Activity[]
  messages      Message[]
  calls         Call[]
  meetings      Meeting[]
  documents     Document[]
  emailLogs     EmailLog[]
  outcomes      DealOutcome[]
  deals         Deal[]
  /// Captured from the page the user was viewing (P1/1e). Personal data:
  /// all three join the erasure cascade and the anonymization job.
  avatarPath    String?       @map("avatar_path")
  bio           String?       @db.Text
  personBrief   String?       @map("person_brief") @db.Text
  briefAt       DateTime?     @map("brief_at")
  /// Owner-defined field values (P5/1), keyed by CustomFieldDef.key. Json
  /// rather than columns because the shape is per workspace; validated
  /// server-side against the definitions with a zod schema built from them, so
  /// a hand-written value cannot reach the table.
  ///
  /// GDPR: a custom field can hold anything a person typed into it, so the
  /// whole object joins the erasure cascade and the anonymization job.
  customFields  Json?         @map("custom_fields")
  /// Set when this lead was merged INTO another (P5/2). See Company.mergedIntoId.
  mergedIntoId  String?       @map("merged_into_id")
  mergedAt      DateTime?     @map("merged_at")
  /// The import that created or last touched this row (P5/3). What makes a
  /// batch rollback able to find its own work without scanning timestamps.
  importBatchId String?       @map("import_batch_id")

  @@index([workspaceId])
  @@index([companyId])
  @@index([workspaceId, ownerId])
  @@index([mergedIntoId])
  @@map("leads")
}

model Activity {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  leadId      String   @map("lead_id")
  type        String
  payload     Json?
  byUserId    String?  @map("by_user_id")
  at          DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([leadId])
  @@map("activities")
}

model Message {
  id          String           @id @default(cuid())
  workspaceId String           @map("workspace_id")
  leadId      String           @map("lead_id")
  direction   MessageDirection
  channel     MessageChannel   @default(LINKEDIN)
  kind        String? // connection | fu1 | fu2 | reply ...
  body        String           @db.Text
  aiDrafted   Boolean          @default(false) @map("ai_drafted")
  /// The EXACT text Claude produced. Kept alongside `body` so "was this really
  /// edited by a human?" is answered by comparison, not by trusting a flag the
  /// client could set (CLAUDE.md hard rule #6).
  aiDraftBody String?          @map("ai_draft_body") @db.Text
  humanEdited Boolean          @default(false) @map("human_edited")
  /// Claude's critique of the current draft (spec §4.6), shown beside it.
  critique    String?          @db.Text
  analysis    Json? // Haiku reply analysis (intent, objection, suggestions)
  status      MessageStatus    @default(DRAFT)
  sentAt      DateTime?        @map("sent_at")
  createdAt   DateTime         @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([leadId])
  @@map("messages")
}

model Frame {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  name        String
  body        String      @db.Text
  segment     String?
  version     Int         @default(1)
  status      FrameStatus @default(DRAFT)
  metrics     Json?
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  campaigns Campaign[]

  @@index([workspaceId])
  @@map("frames")
}

model Meeting {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  leadId        String?  @map("lead_id")
  hostUserId    String?  @map("host_user_id")
  scheduledAt   DateTime @map("scheduled_at")
  durationMin   Int      @default(30) @map("duration_min")
  type          String?
  googleEventId String?  @map("google_event_id")
  eventUrl      String?  @map("event_url")
  brief         String?  @db.Text
  briefStatus   String   @default("none") @map("brief_status")
  briefPdfPath  String?  @map("brief_pdf_path")
  outcome       String?
  /// The follow-up kit assembled when the outcome was logged (playbook-v4
  /// P13/2): the drafted thank-you, the attachments worth sending, and the
  /// quote lines that were discussed. A CHECKLIST, not an outbox — nothing in
  /// it leaves the building without a person pressing something.
  followupKit   Json?    @map("followup_kit")
  createdAt     DateTime @default(now()) @map("created_at")

  lead Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([leadId])
  @@map("meetings")
}

model Insight {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  kind        InsightKind
  body        String      @db.Text
  data        Json?
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("insights")
}

// Signal Engine approval queue (spec §4.13). The weekly job writes PENDING
// proposals; nothing self-modifies. An Owner approve applies the effect
// (versions a frame / updates a score weight); reject discards.
model Proposal {
  id              String         @id @default(cuid())
  workspaceId     String         @map("workspace_id")
  kind            ProposalKind
  title           String
  evidence        String         @db.Text
  n               Int
  data            Json
  status          ProposalStatus @default(PENDING)
  createdAt       DateTime       @default(now()) @map("created_at")
  decidedAt       DateTime?      @map("decided_at")
  decidedByUserId String?        @map("decided_by_user_id")

  @@index([workspaceId])
  @@map("proposals")
}

// Weekly analytics report (spec §4.14). Deterministic numbers in `data`; the
// Haiku "what worked" commentary and Fanni's comment are optional overlays.
model Report {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  weekLabel   String   @map("week_label")
  data        Json
  commentary  String?  @db.Text
  comment     String?  @db.Text
  pdfPath     String?  @map("pdf_path")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([workspaceId])
  @@map("reports")
}

enum ProposalKind {
  FRAME_PROMOTION
  SCORE_WEIGHT
  /// Quarterly win/loss review of a stage's default probability (v2 P4/c).
  STAGE_PROBABILITY
}

enum ProposalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Target {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  metric      String
  period      String // weekly | monthly | q30 | q60 | q90
  value       Int
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, metric, period])
  @@index([workspaceId])
  @@map("targets")
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
}

/// Company-page posts (spec §4.12). Drafted with Claude against a locked brand
/// voice, moved Draft → In review → Approved → Published by hand. Publishing
/// records that a human posted it; the system never posts anywhere itself
/// (CLAUDE.md hard rule #2).
/// One TOPIC on the content board. The texts live in ContentVariant, one per
/// channel: the same subject goes out as a LinkedIn post, a blog article and a
/// newsletter, and those are three renderings of one editorial decision — not
/// three unrelated cards that happen to share a title.
model ContentPost {
  id           String        @id @default(cuid())
  workspaceId  String        @map("workspace_id")
  title        String
  status       ContentStatus @default(DRAFT)
  authorUserId String?       @map("author_user_id")
  approvedBy   String?       @map("approved_by")
  approvedAt   DateTime?     @map("approved_at")
  /// When a human marked the topic published. Where each channel's text
  /// actually went is on the variant, because they are posted separately.
  publishedAt  DateTime?     @map("published_at")
  reviewNote   String?       @map("review_note") @db.Text
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  variants ContentVariant[]

  @@index([workspaceId])
  @@index([workspaceId, status])
  @@map("content_posts")
}

/// One channel's text for a topic. Character limits, the AI-draft comparison and
/// the published URL are all per channel — a 3000-character LinkedIn cap says
/// nothing about the blog version.
model ContentVariant {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  postId       String    @map("post_id")
  /// linkedin | blog | newsletter
  channel      String
  body         String    @default("") @db.Text
  /// True when Claude produced the first version of THIS text.
  aiDrafted    Boolean   @default(false) @map("ai_drafted")
  /// Exactly what Claude produced, so "did a human edit it?" is answered by
  /// comparison rather than by a flag (same reasoning as outreach messages).
  aiDraftBody  String?   @map("ai_draft_body") @db.Text
  /// Where this channel's version was posted, and when.
  publishedAt  DateTime? @map("published_at")
  publishedUrl String?   @map("published_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  post ContentPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, channel])
  @@index([workspaceId])
  @@map("content_variants")
}

/// Per-workspace integration credentials (spec §4.24). Secrets are stored
/// AES-256-GCM encrypted (see src/lib/crypto.ts); non-secret values such as a
/// sending domain are stored in clear so they can be validated and displayed.
/// Infrastructure settings are deliberately NOT here — they stay in env.
model Integration {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  /// Registry key, e.g. "mailgun.cold.apiKey".
  key         String
  /// Encrypted payload for secret fields; null for plain ones.
  valueEnc    String?  @map("value_enc") @db.Text
  /// Clear value for non-secret fields; null for secrets.
  valuePlain  String?  @map("value_plain")
  updatedBy   String?  @map("updated_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("integrations")
}

model AuditLog {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  actorUserId String?  @map("actor_user_id")
  action      String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  meta        Json?
  at          DateTime @default(now())

  @@index([workspaceId])
  @@map("audit_logs")
}

model ProspectSearch {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  keywords    String
  location    String
  radius      String?
  cost        Decimal  @default(0) // USD spent on Places API
  results     Json?    @map("results_json")
  ranAt       DateTime @default(now()) @map("ran_at")
  expiresAt   DateTime @map("expires_at")

  @@index([workspaceId])
  @@map("prospect_searches")
}

model AuditResult {
  id           String       @id @default(cuid())
  workspaceId  String       @map("workspace_id")
  companyId    String?      @map("company_id")
  url          String
  status       String       @default("queued") // queued | running | done | error
  score        Int          @default(0)
  verdict      AuditVerdict @default(SKIP)
  checks       Json?        @map("checks_json")
  flags        Json         @default("[]")
  pitchSummary String?      @map("pitch_summary") @db.Text
  screenshots  Json         @default("[]")
  /// Multi-page crawl result (P2/1). Null on single-page audits — every
  /// public and self-serve run, and any internal run with the toggle off.
  crawl        Json?        @map("crawl_json")
  /// Chrome UX Report field data (P2/2). Null when the origin has too little
  /// traffic for Google to report on — the common case for a micro-SMB site.
  crux         Json?        @map("crux_json")
  /// Competitor side-by-side (P2/3): the audit ids this one is compared with.
  /// Lives on the prospect's audit because the same competitor audit is reused
  /// across several comparisons — a parent pointer on the competitor would be
  /// wrong the second time it is cited.
  comparison   Json?        @map("comparison_json")
  /// What changed since the previous audit of the same URL (P2/5). Null on a
  /// first run — there is nothing to compare against, which is not a delta of
  /// zero.
  delta        Json?        @map("delta_json")
  pdfPath      String?      @map("pdf_path")
  /// Which step of the pipeline the run is on, for the progress panel.
  ///
  /// Separate from `status` on purpose. `status` is the record's lifecycle —
  /// queued / running / done / error — and half a dozen queries key off its
  /// exact values; overloading it with progress labels would have made a
  /// mid-flight audit invisible to the public-audit reuse lookup. The UI used
  /// to guess the step from `status`, which is why it advertised three steps
  /// and could only ever show two.
  stage        String?
  /// Why a run ended in `status = "error"`, in the operator's words.
  /// Without it a failed audit rendered as the word "failed" and nothing
  /// else, which is indistinguishable from a hung one.
  errorMessage String?      @map("error_message") @db.Text
  createdAt    DateTime     @default(now()) @map("created_at")
  expiresAt    DateTime     @map("expires_at")

  company       Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  shares        AuditShare[]
  publicAudits  PublicAudit[]
  /// Which check set and category mapping this audit was scored under.
  /// Reports render a cached audit with ITS version, so an older run keeps the
  /// grouping it was actually scored with instead of being reinterpreted.
  schemaVersion Int           @default(1) @map("schema_version")

  @@index([workspaceId])
  @@index([companyId])
  @@map("audit_results")
}

/// A self-serve audit requested from the public landing page, before any
/// person is known. Anonymous by construction: we hold the URL, the coarse
/// client fingerprint needed for abuse control, and a pointer to the audit.
/// A Lead only appears later, if the visitor submits the report form (P12/1b).
/// A company whose website we re-audit on a schedule (P2/5).
///
/// Watching a prospect is how a second audit ever happens: the first one is a
/// snapshot, and only the comparison produces a reason to call. One row per
/// company, so enabling a watch twice is an update rather than a duplicate.
model AuditWatch {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  companyId     String    @map("company_id")
  /// The URL actually audited — a company's website field can change under us.
  url           String
  /// 30 | 90 | 180. Anything else is refused at the API layer.
  frequencyDays Int       @map("frequency_days")
  enabled       Boolean   @default(true)
  nextRunAt     DateTime  @map("next_run_at")
  lastRunAt     DateTime? @map("last_run_at")
  /// Who or what turned it on, for the audit trail.
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId])
  @@index([workspaceId])
  @@index([nextRunAt])
  @@map("audit_watches")
}

/// An uploaded access log and the aggregate we keep from it (P2/8).
///
/// GDPR: log lines contain IP addresses, which are personal data. The raw file
/// is processed, aggregated, and DELETED within 7 days — `rawPath` goes null
/// when that happens, and only `analysis` survives. Nothing here ever stores a
/// single line.
model LogUpload {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  companyId   String?   @map("company_id")
  filename    String
  bytes       Int
  /// queued | running | done | error
  status      String    @default("queued")
  error       String?   @db.Text
  /// Relative path under FILES_DIR while the raw file still exists.
  rawPath     String?   @map("raw_path")
  /// When the raw upload must be gone by.
  purgeAfter  DateTime  @map("purge_after")
  purgedAt    DateTime? @map("purged_at")
  analysis    Json?
  uploadedBy  String?   @map("uploaded_by")
  createdAt   DateTime  @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([purgeAfter])
  @@map("log_uploads")
}

/// A thing someone has to do (playbook-v2 P3/3).
///
/// POLYMORPHIC LINK by design: a task hangs off a lead today, a deal once P4
/// exists, a document, or nothing at all. entityType + entityId rather than four
/// nullable foreign keys, because the alternative is a schema change every time
/// a new thing becomes taskable.
///
/// The cost of that choice is no cascade: erasing a lead does not delete its
/// tasks automatically, so eraseLeadData removes them explicitly. That is
/// written down here because it is exactly the kind of thing a future migration
/// forgets.
/// A board of work, in the Asana sense: a named container with ordered
/// sections, holding tasks that belong together.
///
/// Deliberately NOT called a project. `Project` in this codebase already means
/// a post-sale delivery engagement carrying a signed contract to its completion
/// certificate, and two meanings for one word in one product is how a team ends
/// up arguing about which "project" somebody meant.
model TaskBoard {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  description String?   @db.Text
  /// Hex accent for the board chip. Validated before it reaches CSS.
  color       String?
  /// Ordering among boards, sparse so a reorder is one write.
  position    Int       @default(0)
  /// Archived boards keep their tasks and stop appearing in pickers.
  archivedAt  DateTime? @map("archived_at")
  createdBy   String?   @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  sections TaskSection[]
  tasks    Task[]

  @@index([workspaceId, archivedAt, position])
  @@map("task_boards")
}

/// A column on the board, and a heading in the list view. The same rows, two
/// arrangements — which is the whole reason sections exist rather than a second
/// status enum.
model TaskSection {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  boardId     String   @map("board_id")
  name        String
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  board TaskBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  tasks Task[]

  @@index([workspaceId, boardId, position])
  @@map("task_sections")
}

model Task {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  /// call | email | todo | follow_up
  type        String    @default("todo")
  title       String
  note        String?   @db.Text
  dueAt       DateTime? @map("due_at")
  /// When the work is meant to START. A task due Friday that takes three days
  /// is not a Friday problem, and a board with only end dates cannot say so.
  startAt     DateTime? @map("start_at")
  /// lead | company | document | none
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  /// Who owes this. Null means unassigned, which is visible rather than hidden.
  assigneeId  String?   @map("assignee_id")
  doneAt      DateTime? @map("done_at")
  completedBy String?   @map("completed_by")
  /// Set when the system created it from a signal, so the UI can say why this
  /// task exists — and so a person's own tasks are distinguishable from ours.
  source      String?
  createdBy   String?   @map("created_by")

  // ---- board layer -------------------------------------------------------
  /// Null for a loose task — a follow-up raised from a lead, a signal's
  /// suggested call. Those existed long before boards did and must keep
  /// working without one.
  boardId   String? @map("board_id")
  sectionId String? @map("section_id")
  /// Rank within its section. Sparse (steps of 1024) so dragging a card
  /// between two others is one write rather than a renumber of the column.
  position  Int     @default(0)
  /// none | low | medium | high | urgent
  priority  String  @default("none")
  /// Free-text labels, as a JSON array of strings.
  tags      Json    @default("[]")
  /// Subtasks. A parent's completion never cascades — ticking a summary line
  /// to make its children disappear is how work gets lost.
  parentId  String? @map("parent_id")

  board     TaskBoard?     @relation(fields: [boardId], references: [id], onDelete: SetNull)
  section   TaskSection?   @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  parent    Task?          @relation("Subtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks  Task[]         @relation("Subtasks")
  comments  TaskComment[]
  followers TaskFollower[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([workspaceId, doneAt, dueAt])
  @@index([workspaceId, entityType, entityId])
  @@index([assigneeId, doneAt])
  @@index([workspaceId, boardId, sectionId, position])
  @@index([workspaceId, parentId])
  @@map("tasks")
}

/// The conversation on a task. Where the decision that changed the work gets
/// written down, instead of in a chat nobody can find six weeks later.
model TaskComment {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  taskId      String    @map("task_id")
  userId      String    @map("user_id")
  body        String    @db.Text
  /// Users named with @ in the body, as a JSON array of user ids. Stored at
  /// write time so a later rename cannot silently un-mention somebody.
  mentions    Json      @default("[]")
  editedAt    DateTime? @map("edited_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([workspaceId, taskId, createdAt])
  @@map("task_comments")
}

/// Who hears about this task. The assignee is one; anybody who comments or is
/// mentioned becomes another, which is how a question asked on a task reaches
/// the person who can answer it.
model TaskFollower {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  taskId      String   @map("task_id")
  userId      String   @map("user_id")
  createdAt   DateTime @default(now()) @map("created_at")

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([workspaceId, userId])
  @@map("task_followers")
}

// ============================================================================
// Email sync (playbook-v2 P2). Correspondence lives in a personal mailbox; the
// CRM only ever saw what someone pasted in. These tables hold the SUBSET that
// matches a known lead or company — never the mailbox at large.
// ============================================================================

/// One connected mailbox, and the state of syncing it.
///
/// Health is a stored field rather than something inferred at render time, so
/// Settings can say "reconnect needed" without probing Google on page load —
/// and so a token that expired at 3am is visible before someone wonders why the
/// timeline went quiet.
model MailAccount {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  userId         String    @map("user_id")
  /// gmail — the only provider today. IMAP arrives behind the same interface.
  provider       String    @default("gmail")
  /// Which mailbox this is, for the UI and to keep reconnects idempotent.
  accountEmail   String    @map("account_email")
  /// The GoogleCredential carrying the mail scopes (purpose = "MAIL").
  credentialId   String?   @map("credential_id")
  /// The `after:` boundary the next incremental pass starts from.
  watermark      DateTime?
  /// How far the 90-day backfill has walked back, so it can resume.
  backfillCursor DateTime? @map("backfill_cursor")
  backfillDone   Boolean   @default(false) @map("backfill_done")
  /// ok | reconnect_needed | rate_limited | error
  health         String    @default("ok")
  lastError      String?   @map("last_error") @db.Text
  lastSyncAt     DateTime? @map("last_sync_at")
  enabled        Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  threads EmailThread[]

  @@unique([userId, accountEmail])
  @@index([workspaceId])
  @@map("mail_accounts")
}

/// A conversation, matched to a lead or company.
model EmailThread {
  id               String   @id @default(cuid())
  workspaceId      String   @map("workspace_id")
  accountId        String   @map("account_id")
  /// Gmail's thread id, so a reply threads correctly for the recipient.
  providerThreadId String   @map("provider_thread_id")
  subject          String?  @db.Text
  leadId           String?  @map("lead_id")
  companyId        String?  @map("company_id")
  /// address | domain | manual. Recording HOW it matched is what lets a
  /// domain guess be corrected without the next sync re-matching it the same
  /// wrong way.
  matchType        String   @default("address") @map("match_type")
  lastMessageAt    DateTime @map("last_message_at")
  messageCount     Int      @default(0) @map("message_count")
  unread           Boolean  @default(false)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  account  MailAccount    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  messages EmailMessage[]

  @@unique([accountId, providerThreadId])
  @@index([workspaceId, lastMessageAt])
  @@index([leadId])
  @@map("email_threads")
}

/// One message. Attachment BYTES are fetched on demand; only metadata lives
/// here, so a synced mailbox does not become a second copy of every PDF a
/// client ever sent.
model EmailMessage {
  id                String    @id @default(cuid())
  workspaceId       String    @map("workspace_id")
  threadId          String    @map("thread_id")
  providerMessageId String    @map("provider_message_id")
  /// INBOUND | OUTBOUND, from the mailbox owner's point of view.
  direction         String
  fromAddress       String    @map("from_address")
  fromName          String?   @map("from_name")
  /// JSON arrays of addresses.
  toAddresses       Json      @map("to_addresses")
  ccAddresses       Json?     @map("cc_addresses")
  subject           String?   @db.Text
  snippet           String?   @db.Text
  /// Sanitized on ingest AND rendered in a sandboxed iframe. Email HTML is
  /// hostile input from strangers; one layer is not enough.
  bodyHtml          String?   @map("body_html") @db.Text
  bodyText          String?   @map("body_text") @db.Text
  hasAttachments    Boolean   @default(false) @map("has_attachments")
  /// [{ filename, mimeType, sizeBytes, providerAttachmentId, storedPath? }]
  attachments       Json?
  sentAt            DateTime  @map("sent_at")
  /// When the Haiku reply analysis ran, if it ever did. Never set by backfill.
  analyzedAt        DateTime? @map("analyzed_at")
  /// Open/click tracking for a message WE sent from the app (playbook-v3 P9/1).
  /// Null when the sender turned tracking off — and then the message carries no
  /// pixel, no rewritten links and no notice, which a test asserts on the MIME.
  trackingId        String?   @unique @map("tracking_id")
  /// The links as they were at send time, in order. The redirect endpoint takes
  /// an INDEX into this array rather than a URL, so the endpoint cannot be
  /// turned into an open redirect.
  trackedLinks      Json?     @map("tracked_links")
  createdAt         DateTime  @default(now()) @map("created_at")

  thread      EmailThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  trackEvents EmailTrackEvent[]

  @@unique([threadId, providerMessageId])
  @@index([workspaceId, sentAt])
  @@map("email_messages")
}

/// A learned address→lead mapping, written when someone links an unmatched
/// thread by hand.
///
/// Without this the unmatched queue is endless manual work: the same person
/// writing from the same address would need linking every time. One correction
/// teaches the matcher permanently.
model AddressLink {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  email       String
  leadId      String?  @map("lead_id")
  companyId   String?  @map("company_id")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([workspaceId, email])
  @@index([workspaceId])
  @@map("address_links")
}

/// Someone asked for their audit report, and what exactly they agreed to
/// (P12/1b).
///
/// This is EVIDENCE, not a preference flag. "Did they consent?" is the easy
/// question; the one that actually gets asked is "what wording did they agree
/// to, when, and from where" — so the text version, the timestamp and the full
/// IP are all part of the record. PublicAudit stores a truncated IP prefix
/// because that is abuse control; this stores the whole address because the
/// visitor asked us for something and we may have to show that they did.
model PublicAuditConsent {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  publicAuditId      String    @map("public_audit_id")
  name               String
  email              String
  companyName        String?   @map("company_name")
  /// Always true — a row cannot exist without it, since it is what authorises
  /// the delivery. Stored anyway so the record is self-describing.
  serviceConsent     Boolean   @default(true) @map("service_consent")
  /// The lawful basis for any later outreach. Defaults FALSE and is only ever
  /// set by an affirmative tick: a pre-checked box is not consent.
  marketingConsent   Boolean   @default(false) @map("marketing_consent")
  /// Which wording they saw, e.g. "hu-2026-08-14". Replacing the text later
  /// must not invalidate consent collected under the old one.
  consentTextVersion String    @map("consent_text_version")
  /// The language the form was presented in.
  locale             String    @default("hu")
  ip                 String?
  userAgent          String?   @map("user_agent")
  /// The lead this became, once created.
  leadId             String?   @map("lead_id")
  /// When the report was actually delivered, for support questions.
  reportSentAt       DateTime? @map("report_sent_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, createdAt])
  @@index([publicAuditId])
  @@index([email])
  @@map("public_audit_consents")
}

/// A search term we track a company's position for (P2/7).
///
/// Known terms only — this system does no keyword research and holds no
/// search-volume data, so a keyword exists here because someone typed it.
model TrackedKeyword {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  companyId   String   @map("company_id")
  keyword     String
  /// hu-HU unless told otherwise.
  locale      String   @default("hu-HU")
  /// Local intent, e.g. "Budapest,Hungary".
  location    String?
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")

  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  positions KeywordPosition[]

  @@unique([companyId, keyword, locale])
  @@index([workspaceId])
  @@map("tracked_keywords")
}

/// One weekly measurement. `position` null means "not in the first hundred",
/// which is a real answer and must not be stored as a large number.
model KeywordPosition {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  keywordId   String   @map("keyword_id")
  position    Int?
  url         String?
  checkedAt   DateTime @default(now()) @map("checked_at")

  keyword TrackedKeyword @relation(fields: [keywordId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([keywordId, checkedAt])
  @@map("keyword_positions")
}

/// Personal token letting the browser extension post captures on a user's
/// behalf. The extension runs on linkedin.com, so it cannot use the app's
/// session cookie — this is the credential instead. Hashed at rest, revocable,
/// and scoped to one user in one workspace.
model CaptureToken {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  workspaceId String    @map("workspace_id")
  /// sha256 of the token. The plaintext is shown once, at creation.
  tokenHash   String    @unique @map("token_hash")
  label       String?
  lastUsedAt  DateTime? @map("last_used_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([workspaceId])
  @@map("capture_tokens")
}

model PublicAudit {
  id            String   @id @default(cuid())
  /// Which workspace receives this inbound. Resolved by getPublicIntakeWorkspace().
  workspaceId   String   @map("workspace_id")
  url           String
  /// Registrable host, lower-cased — what dedupe and the client blocklist match on.
  domain        String
  auditId       String?  @map("audit_id")
  /// queued | running | done | error | blocked
  status        String   @default("queued")
  /// Set when the request was refused, e.g. rate_limited, client_domain, bot.
  blockedReason String?  @map("blocked_reason")
  /// Truncated to a /24 (IPv4) or /48 (IPv6): enough for rate limiting, not a
  /// precise location. The full address is only stored on a consent record,
  /// where it is evidence the visitor asked for something.
  ipPrefix      String?  @map("ip_prefix")
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  /// The audit this request produced, once the worker has one.
  audit AuditResult? @relation(fields: [auditId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([domain])
  @@index([status])
  @@map("public_audits")
}

model AuditShare {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  auditId       String    @map("audit_id")
  leadId        String?   @map("lead_id")
  slug          String    @unique
  firstOpenedAt DateTime? @map("first_opened_at")
  openCount     Int       @default(0) @map("open_count")
  expiresAt     DateTime  @map("expires_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  audit AuditResult @relation(fields: [auditId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([auditId])
  @@map("audit_shares")
}

model Template {
  id          String         @id @default(cuid())
  workspaceId String         @map("workspace_id")
  type        TemplateType
  lang        Lang           @default(HU)
  name        String
  body        String         @db.Text
  variables   Json           @default("[]")
  version     Int            @default(1)
  status      TemplateStatus @default(DRAFT)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  documents Document[]

  @@index([workspaceId])
  @@map("templates")
}

model Document {
  id                String         @id @default(cuid())
  workspaceId       String         @map("workspace_id")
  leadId            String?        @map("lead_id")
  /// The deal this document belongs to (v2 P4/b). The chain hangs off the DEAL
  /// once one exists — a company that buys twice has two quotes, and hanging
  /// both off the lead made them look like one chain with a duplicate step.
  /// Nullable: documents older than the deals layer keep their lead link only.
  dealId            String?        @map("deal_id")
  templateVersionId String?        @map("template_version_id")
  chainParentId     String?        @map("chain_parent_id")
  type              DocumentType
  /// Human-facing number (Q-2026-014). Denormalised out of `payload` so global
  /// search can match it — JSON fields are not portably searchable across
  /// Postgres and MySQL.
  number            String?
  status            DocumentStatus @default(DRAFT)
  watermark         Boolean        @default(true)
  payload           Json?          @map("payload_json")
  totals            Json?          @map("totals_json")
  pdfUrl            String?        @map("pdf_url")
  acceptSlug        String?        @unique @map("accept_slug")
  /// The branding this document was RENDERED under (audit-v2 item 6).
  ///
  /// Pinned for the same reason templateVersionId pins the wording: a document
  /// that has been sent to a client is a record of what was sent, and
  /// re-rendering it after the letterhead changed would quietly reissue it with
  /// a different identity on it. Null means "never rendered" — the first render
  /// captures the snapshot.
  brandSnapshot     Json?          @map("brand_snapshot")
  brandVersion      Int?           @map("brand_version")
  finalizedAt       DateTime?      @map("finalized_at")
  /// When a completion certificate was acknowledged (playbook-v4 P13/3).
  /// Its own column rather than `updatedAt`: the referral job needs "fourteen
  /// days since the client confirmed", and `updatedAt` moves whenever anything
  /// on the row is touched — including by the job itself.
  acknowledgedAt    DateTime?      @map("acknowledged_at")
  finalizedBy       String?        @map("finalized_by")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  lead        Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  deal        Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  template    Template?         @relation(fields: [templateVersionId], references: [id], onDelete: SetNull)
  chainParent Document?         @relation("DocumentChain", fields: [chainParentId], references: [id], onDelete: SetNull)
  chainChild  Document[]        @relation("DocumentChain")
  emailLogs   EmailLog[]
  acceptances QuoteAcceptance[]
  invoices    Invoice[]

  @@index([workspaceId])
  @@index([leadId])
  @@index([workspaceId, number])
  @@index([dealId])
  @@map("documents")
}

model EmailLog {
  id          String      @id @default(cuid())
  workspaceId String      @map("workspace_id")
  leadId      String?     @map("lead_id")
  documentId  String?     @map("document_id")
  to          String
  subject     String
  mailgunId   String?     @map("mailgun_id")
  status      EmailStatus @default(QUEUED)
  at          DateTime    @default(now())

  lead     Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)
  document Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@map("email_logs")
}

model Call {
  id             String      @id @default(cuid())
  workspaceId    String      @map("workspace_id")
  leadId         String      @map("lead_id")
  outcome        CallOutcome
  note           String?     @db.Text
  duration       Int? // seconds
  callbackAt     DateTime?   @map("callback_at")
  callbackDoneAt DateTime?   @map("callback_done_at")
  byUserId       String?     @map("by_user_id")
  at             DateTime    @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([leadId])
  @@map("calls")
}

model Campaign {
  id             String         @id @default(cuid())
  workspaceId    String         @map("workspace_id")
  frameId        String?        @map("frame_id")
  name           String
  segmentQuery   Json?          @map("segment_query")
  status         CampaignStatus @default(DRAFT)
  complianceNote String?        @map("compliance_note") @db.Text
  dailyCap       Int            @default(20) @map("daily_cap")
  startedAt      DateTime?      @map("started_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  frame      Frame?              @relation(fields: [frameId], references: [id], onDelete: SetNull)
  steps      CampaignStep[]
  recipients CampaignRecipient[]

  @@index([workspaceId])
  @@map("campaigns")
}

model CampaignStep {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  campaignId  String  @map("campaign_id")
  stepNumber  Int     @map("step_number")
  delayDays   Int     @default(0) @map("delay_days")
  subject     String?
  body        String  @db.Text

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([campaignId])
  @@map("campaign_steps")
}

model CampaignRecipient {
  id             String    @id @default(cuid())
  workspaceId    String    @map("workspace_id")
  campaignId     String    @map("campaign_id")
  leadId         String?   @map("lead_id")
  email          String
  suppressed     Boolean   @default(false)
  bounced        Boolean   @default(false)
  /// The verdict at the moment this audience was checked (P9/2). A snapshot,
  /// not a link: what the campaign was armed on is what an audit needs to see,
  /// even after the lead's address has been re-verified since.
  verifyStatus   String?   @map("verify_status")
  verifyReason   String?   @map("verify_reason")
  /// A risky address only goes out after a human says so, per address.
  riskAcceptedAt DateTime? @map("risk_accepted_at")
  riskAcceptedBy String?   @map("risk_accepted_by")
  stepSent       Int       @default(0) @map("step_sent")
  repliedAt      DateTime? @map("replied_at")
  sentAt         DateTime? @map("sent_at")

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([campaignId])
  @@map("campaign_recipients")
}

model Referrer {
  id              String       @id @default(cuid())
  workspaceId     String       @map("workspace_id")
  kind            ReferrerKind
  name            String
  linkedCompanyId String?      @map("linked_company_id")
  createdAt       DateTime     @default(now()) @map("created_at")

  linkedCompany Company? @relation(fields: [linkedCompanyId], references: [id], onDelete: SetNull)
  leads         Lead[]

  @@index([workspaceId])
  @@map("referrers")
}

model RegistryData {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  companyId     String   @unique @map("company_id")
  taxId         String?  @map("tax_id")
  regNumber     String?  @map("reg_number")
  legalName     String?  @map("legal_name")
  headcountBand String?  @map("headcount_band")
  revenueBand   String?  @map("revenue_band")
  statusFlags   Json     @default("[]") @map("status_flags")
  fetchedAt     DateTime @default(now()) @map("fetched_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("registry_data")
}

model DealOutcome {
  id          String     @id @default(cuid())
  workspaceId String     @map("workspace_id")
  leadId      String     @map("lead_id")
  /// The deal this outcome closed (v2 P4). Nullable because outcomes recorded
  /// before the deals layer existed have no deal behind them, and inventing one
  /// retroactively would fabricate money-journey history that never happened.
  dealId      String?    @map("deal_id")
  result      DealResult
  reason      String?
  value       Int? // HUF forints
  competitor  String?
  at          DateTime   @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  deal Deal? @relation(fields: [dealId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([leadId])
  @@index([dealId])
  @@map("deal_outcomes")
}

// ============================================================================
// Deals layer (playbook-v2 P4). A Lead is a PERSON we are trying to reach; a
// Deal is a piece of WORK with money attached. They were the same row until
// now, which is why "how much is in the pipeline" had no answer and why one
// company could only ever be worth one thing at a time.
//
// The boundary: a lead owns the pre-deal journey (Researched → Replied); a deal
// owns everything from Qualified onward. Lead.stage is untouched by this layer
// — the migration ADDS deals beside the leads it derived them from rather than
// moving state, so the change is reversible without reconstructing anything.
// ============================================================================

/// A named board. Pipelines are DATA, not an enum, because "Web projects" and
/// "Grants" close on completely different clocks and a workspace must be able
/// to add a third without a deploy.
model Pipeline {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  /// Stable slug, so seeds and migrations can find a pipeline by meaning rather
  /// than by a name someone has since renamed.
  key         String
  position    Int      @default(0)
  /// Where a converted lead lands when nothing else decides.
  isDefault   Boolean  @default(false) @map("is_default")
  /// Archived rather than deleted: a pipeline with deals in it cannot go away
  /// without taking their history with it.
  archived    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stages DealStage[]
  deals  Deal[]

  @@unique([workspaceId, key])
  @@index([workspaceId, position])
  @@map("pipelines")
}

/// One column on a pipeline board.
model DealStage {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  pipelineId  String   @map("pipeline_id")
  name        String
  key         String
  position    Int      @default(0)
  /// 0-100. The forecast's weight for any deal sitting here that has not
  /// overridden it.
  probability Int      @default(0)
  /// Days in this stage before the card is flagged as rotting. Null = never.
  rottingDays Int?     @map("rotting_days")
  /// open | won | lost. A stage's kind is what makes a drag onto it close the
  /// deal — the alternative is matching on the stage's NAME, which breaks the
  /// moment someone renames "Won" to "Signed".
  kind        String   @default("open")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  pipeline Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals    Deal[]

  @@unique([pipelineId, key])
  @@index([workspaceId])
  @@index([pipelineId, position])
  @@map("deal_stages")
}

/// A piece of work with money attached.
model Deal {
  id              String     @id @default(cuid())
  workspaceId     String     @map("workspace_id")
  /// The person it came through, and the company that would pay. Both nullable
  /// and both kept: erasing a lead must not erase the revenue record, and a
  /// renewal can outlive the contact who introduced it.
  leadId          String?    @map("lead_id")
  companyId       String?    @map("company_id")
  title           String
  /// Integer forints (CLAUDE.md — money is never a float).
  value           Int        @default(0)
  currency        String     @default("HUF")
  expectedCloseAt DateTime?  @map("expected_close_at")
  /// 0-100 override. NULL means "whatever the stage says", so moving a deal
  /// re-weights it automatically until someone states an opinion.
  probability     Int?
  pipelineId      String     @map("pipeline_id")
  stageId         String     @map("stage_id")
  stageEnteredAt  DateTime   @default(now()) @map("stage_entered_at")
  ownerId         String?    @map("owner_id")
  status          DealStatus @default(OPEN)
  closedAt        DateTime?  @map("closed_at")
  lostReason      String?    @map("lost_reason")
  /// Owner-defined field values (P5/1). See Lead.customFields.
  customFields    Json?      @map("custom_fields")
  /// "p4_migration" for the rows the deals migration derived from lead stages.
  /// This is what makes the migration reversible: rollback deletes exactly the
  /// rows it created and nothing a person has since added by hand.
  source          String?
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  pipeline      Pipeline       @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stage         DealStage      @relation(fields: [stageId], references: [id], onDelete: Restrict)
  documents     Document[]
  outcomes      DealOutcome[]
  subscriptions Subscription[]

  @@index([workspaceId, status])
  @@index([workspaceId, pipelineId, stageId])
  @@index([leadId])
  @@index([companyId])
  @@index([workspaceId, expectedCloseAt])
  @@map("deals")
}

// Public per-host scheduling page (spec §4.21). slug is globally unique — the
// public path segment on meet.{domain}/{slug}. meeting_types_json holds
// [{ id, label, durationMin }]; config holds working hours, slot step, buffers,
// notice, horizon, timezone.
model BookingPage {
  id           String   @id @default(cuid())
  workspaceId  String   @map("workspace_id")
  hostUserId   String   @map("host_user_id")
  slug         String   @unique
  title        String?
  meetingTypes Json     @default("[]") @map("meeting_types_json")
  config       Json?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([workspaceId])
  @@map("booking_pages")
}

model QuoteAcceptance {
  id             String   @id @default(cuid())
  workspaceId    String   @map("workspace_id")
  documentId     String   @map("document_id")
  acceptedByName String   @map("accepted_by_name")
  company        String?
  ip             String?
  userAgent      String?  @map("user_agent")
  at             DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([documentId])
  @@map("quote_acceptances")
}

/// An invoice, and — since P11/1d — the payment ledger the commission reads.
///
/// Commission is "10% of net actually RECEIVED in that month", so the ledger
/// needs three things Invoice did not carry: how much (net, VAT excluded), WHEN
/// the money arrived, and who it came from. Deriving them from the linked
/// Document was not an option: a subscription invoice has no document at all.
model Invoice {
  id             String        @id @default(cuid())
  workspaceId    String        @map("workspace_id")
  documentId     String?       @map("document_id")
  /// Direct link, because a recurring invoice has no document to reach it through.
  companyId      String?       @map("company_id")
  /// Set when this invoice bills a subscription; null for one-off work. This is
  /// what separates the two commission rules from each other.
  subscriptionId String?       @map("subscription_id")
  szamlazzId     String?       @map("szamlazz_id")
  number         String?
  pdfUrl         String?       @map("pdf_url")
  status         InvoiceStatus @default(PREPARED)
  /// NET forints, VAT excluded (CLAUDE.md: HUF is an integer, never a float).
  netAmount      Int?          @map("net_amount")
  /// When the money actually arrived — set by the Számlázz.hu poll. The month
  /// of THIS date decides which commission run the payment falls into, which is
  /// not the same as the month the invoice was issued.
  paidAt         DateTime?     @map("paid_at")
  /// When it went back out again, and how much of it.
  refundedAt     DateTime?     @map("refunded_at")
  refundedNet    Int?          @map("refunded_net")
  at             DateTime      @default(now())

  document     Document?     @relation(fields: [documentId], references: [id], onDelete: SetNull)
  company      Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  /// The commission run: everything received in one month, by company.
  @@index([workspaceId, paidAt])
  @@index([companyId])
  @@map("invoices")
}

/// The recurring book (playbook-v3 P11/1a). One-off revenue stays on invoices;
/// this carries what repeats.
model Subscription {
  id          String             @id @default(cuid())
  workspaceId String             @map("workspace_id")
  companyId   String             @map("company_id")
  /// Where this engagement came from. Commission attribution walks lead ->
  /// owner, and lead -> referrer, so it has to survive on the subscription.
  leadId      String?            @map("lead_id")
  /// The deal this recurring engagement was won on (v2 P4). Nullable, as the
  /// earlier note here predicted: the MRR maths reads companyId, so nothing in
  /// it had to be rewritten — only commission attribution now prefers the
  /// deal's owner when there is one.
  dealId      String?            @map("deal_id")
  planName    String             @map("plan_name")
  /// Monthly NET in integer forints.
  monthlyNet  Int                @map("monthly_net")
  /// Day of month the invoice goes out. 1-28 only, so February always exists.
  billingDay  Int                @default(1) @map("billing_day")
  startDate   DateTime           @map("start_date")
  status      SubscriptionStatus @default(ACTIVE)
  churnedAt   DateTime?          @map("churned_at")
  /// From the closed CHURN_REASONS list, so the breakdown is countable.
  churnReason String?            @map("churn_reason")
  /// ventstudio | hosting | retainer | other
  source      String             @default("other")
  note        String?            @db.Text
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal     Deal?               @relation(fields: [dealId], references: [id], onDelete: SetNull)
  events   SubscriptionEvent[]
  invoices Invoice[]

  @@index([workspaceId, status])
  @@index([companyId])
  @@index([dealId])
  @@map("subscriptions")
}

/// APPEND-ONLY history of the recurring book (playbook-v3 P11/1b).
///
/// The movement chart sums these deltas; it does not reconstruct history from
/// the current state, because reconstruction cannot tell "raised to 150k in
/// March" from "started at 150k in March" and loses anything later undone.
/// Nothing updates or deletes a row here — a correction is another row.
model SubscriptionEvent {
  id              String   @id @default(cuid())
  workspaceId     String   @map("workspace_id")
  subscriptionId  String   @map("subscription_id")
  /// new | expansion | contraction | churn | reactivation | pause | resume
  kind            String
  /// SIGNED change to MRR in integer forints. Summing every delta for a
  /// subscription gives exactly what it contributes today — that identity is
  /// what makes the chart trustworthy.
  deltaNet        Int      @map("delta_net")
  monthlyNetAfter Int      @map("monthly_net_after")
  /// Churn rows carry the reason, so the breakdown reads from the log.
  reason          String?
  at              DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  /// The chart's query: everything in a period, oldest first.
  @@index([workspaceId, at])
  @@index([subscriptionId, at])
  @@map("subscription_events")
}

model Suppression {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  address     String
  reason      String?
  at          DateTime @default(now())

  @@unique([workspaceId, address])
  @@index([workspaceId])
  @@map("suppressions")
}

/// One billable (or quota-consuming) call to an external API (P2 follow-up).
///
/// Claude has its own table and its own enforced daily cap; this is everything
/// else we spend money or quota on, in one place, so "what did this month
/// cost" has a single answer. Free APIs are recorded too — for PageSpeed and
/// CrUX the meaningful number is calls against Google's quota, not dollars.
model ApiUsage {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  /// dataforseo | pagespeed | crux | places
  provider    String
  /// What was asked for, e.g. "serp.organic" or "audit".
  operation   String
  /// HTTP requests this row represents — CrUX may retry a www counterpart.
  calls       Int      @default(1)
  /// USD. Exactly 0 for the free Google APIs, and that is the honest value.
  cost        Decimal  @default(0)
  at          DateTime @default(now())

  @@index([workspaceId, at])
  @@map("api_usage")
}

model ClaudeUsage {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  useCase     String   @map("use_case")
  model       String
  tokensIn    Int      @default(0) @map("tokens_in")
  tokensOut   Int      @default(0) @map("tokens_out")
  cost        Decimal  @default(0) // USD
  at          DateTime @default(now())

  @@index([workspaceId])
  @@map("claude_usage")
}

/// One thing that happened, addressed to one person (playbook-v2 P6/1).
/// Per-user rather than per-workspace: "your lead replied" is not news to
/// everyone, and a shared feed cannot carry a per-person read state.
model Notification {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  /// One of NOTIFICATION_TYPES. A string, not an enum, so retiring a type is a
  /// code change rather than a migration — resolveChannels() ignores unknown
  /// ones, so an orphaned row degrades to silence instead of breaking a render.
  type        String
  title       String
  body        String?   @db.Text
  /// Where clicking it goes. Stored rather than derived so an old notification
  /// still points somewhere sensible after the route that made it has moved.
  href        String
  entityType  String?   @map("entity_type")
  entityId    String?   @map("entity_id")
  readAt      DateTime? @map("read_at")
  /// One event, one notification — see dedupeKeyFor(). Unique per recipient, so
  /// a retried job or a repeating sweep cannot stack duplicates in the bell.
  dedupeKey   String    @map("dedupe_key")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@unique([workspaceId, userId, dedupeKey])
  /// The bell's query: this person's unread, newest first.
  @@index([workspaceId, userId, readAt, createdAt])
  /// The 90-day retention sweep.
  @@index([createdAt])
  @@map("notifications")
}

/// Per user, per workspace, per type: in-app / push / email-digest.
/// A ROW ONLY EXISTS ONCE SOMEONE CHANGES SOMETHING — absence means "the
/// defaults in types.ts", so changing a default reaches everyone who never
/// expressed an opinion.
model NotificationPreference {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  userId      String   @map("user_id")
  type        String
  /// NULL means "no opinion — use the per-type default in types.ts".
  /// Nullable rather than defaulted, because a column default is a SECOND set
  /// of defaults that silently disagrees with the code's: a row written with
  /// only `push` set would take the column defaults for the other two and quietly
  /// switch off a channel the type turns on.
  inApp       Boolean? @map("in_app")
  push        Boolean?
  emailDigest Boolean? @map("email_digest")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([workspaceId, userId, type])
  @@index([workspaceId, userId])
  @@map("notification_preferences")
}

/// A browser push endpoint (Web Push / VAPID), one row per device.
model PushSubscription {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  userId       String    @map("user_id")
  /// The full endpoint URL. @db.Text because push services issue long ones.
  endpoint     String    @db.Text
  /// sha256(endpoint). The uniqueness key: a TEXT column cannot carry a unique
  /// index on MySQL without a prefix length, and the schema must run on both
  /// flavours (CLAUDE.md).
  endpointHash String    @unique @map("endpoint_hash")
  /// Encryption material from the browser's PushSubscription.
  p256dh       String    @db.Text
  auth         String
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")
  /// Set when the push service says the endpoint is gone (404/410); the sender
  /// prunes these rather than retrying a subscription that no longer exists.
  failedAt     DateTime? @map("failed_at")

  @@index([workspaceId, userId])
  @@map("push_subscriptions")
}

/// A WHEN / IF / THEN rule (playbook-v2 P7/5).
///
/// WORKFLOW-LITE, and the "lite" is load-bearing. Twenty rules, one trigger
/// each, a flat condition list and a short action list — deliberately not a
/// graph, because a workflow engine you can draw loops in is a workflow engine
/// somebody will draw a loop in.
///
/// THE ONE RULE THAT CANNOT BEND (CLAUDE.md hard rule #2): the email action
/// produces a DRAFT a human must open, read and send. There is no configuration
/// that makes it send, and there is no code path that would.
model WorkflowRule {
  id            String   @id @default(cuid())
  workspaceId   String   @map("workspace_id")
  name          String
  /// lead_stage_changed | deal_stage_changed | quote_accepted |
  /// meeting_outcome_logged | task_overdue | lead_created
  trigger       String
  /// Trigger-specific settings, e.g. { toStage } or { days } or { source }.
  triggerConfig Json     @default("{}") @map("trigger_config")
  /// [{ field, operator, value }] — ANDed. Custom fields use `cf:<key>`.
  conditions    Json     @default("[]")
  /// [{ type, ...config }] in order.
  actions       Json     @default("[]")
  /// The kill switch. Off means the rule is kept and does nothing.
  enabled       Boolean  @default(true)
  /// Bumped on every edit, and stamped onto each run — so a run log entry says
  /// which VERSION of the rule produced it, and a rule someone rewrote last
  /// week cannot be read as an explanation of what happened the week before.
  version       Int      @default(1)
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  runs WorkflowRun[]

  @@unique([workspaceId, name])
  @@index([workspaceId, enabled])
  @@map("workflow_rules")
}

/// What fired, on what, and what happened (playbook-v2 P7/5).
///
/// Every evaluation is logged, including the ones that matched nothing —
/// "why did my rule not fire?" is the question an execution log exists to
/// answer, and a log that only records successes cannot answer it.
model WorkflowRun {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  ruleId      String   @map("rule_id")
  ruleVersion Int      @map("rule_version")
  trigger     String
  entityType  String?  @map("entity_type")
  entityId    String?  @map("entity_id")
  /// matched | no_match | skipped | failed
  status      String
  /// One line a person can read: what it did, or why it did not.
  detail      String   @db.Text
  /// Per-action outcomes, for the detail view.
  results     Json     @default("[]")
  /// How deep in a chain of rule-triggered-rule this run sat. Cycle protection.
  depth       Int      @default(0)
  at          DateTime @default(now())

  rule WorkflowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([workspaceId, at])
  @@index([ruleId, at])
  @@map("workflow_runs")
}

/// One undoable action, and the inverse that undoes it (playbook-v2 P7/2).
///
/// COMMAND PATTERN, SERVER SIDE. The playbook is explicit that undo must not be
/// a client-side illusion, and the reason is concurrency: if the browser holds
/// "put it back to Contacted" and somebody else has since moved the lead to
/// Replied, replaying the client's memory silently overwrites their work. The
/// inverse is stored WITH the state the action left behind, so the undo can
/// check that nothing has changed underneath it and decline if it has.
///
/// Short-lived by design: the toast offers six seconds and the row is useless
/// after a few minutes. The retention sweep clears them.
model UndoEntry {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  userId      String    @map("user_id")
  /// lead_stage | deal_stage | task_done | bulk_stage | bulk_signals |
  /// bulk_owner | lead_not_now | content_status
  kind        String
  /// Human-readable, for the toast: "Moved 12 leads to Contacted".
  label       String
  /// The inverse operation's payload — what to write, and to what.
  inverse     Json
  /// What the action LEFT. The undo refuses if the live rows no longer match,
  /// because that means somebody else has touched them since.
  expected    Json
  undoneAt    DateTime? @map("undone_at")
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([workspaceId, userId, createdAt])
  @@index([expiresAt])
  @@map("undo_entries")
}

/// A reusable CSV column mapping (playbook-v2 P5/3).
///
/// Imports come from the same handful of sources over and over — the same
/// export from the same directory, month after month — and re-mapping fourteen
/// columns each time is where mistakes get made.
model ImportTemplate {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  /// Where the file comes from, for the operator's own memory. Free text.
  source      String?
  /// { "contactName": 0, "cf:segment": 4, ... } — target -> column index.
  mapping     Json
  /// Per-target coercions, e.g. { "cf:renew_date": "date_hu" }. Empty is normal.
  coercions   Json     @default("{}")
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  batches ImportBatch[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@map("import_templates")
}

/// One run of an import, and everything needed to undo it (playbook-v2 P5/3).
///
/// `records` is the whole reason this table exists: it holds, per touched row,
/// what the import DID (created or updated), what the row looked like BEFORE
/// (so an update can be reverted) and what it looked like AFTER (so a later
/// manual edit is detectable). A rollback that cannot tell "the import wrote
/// this" from "a person fixed it afterwards" is not a rollback, it is a second
/// data loss.
model ImportBatch {
  id            String    @id @default(cuid())
  workspaceId   String    @map("workspace_id")
  filename      String?
  templateId    String?   @map("template_id")
  /// completed | rolled_back
  status        String    @default("completed")
  createdCount  Int       @default(0) @map("created_count")
  updatedCount  Int       @default(0) @map("updated_count")
  skippedCount  Int       @default(0) @map("skipped_count")
  /// [{ entity, id, action, before, after }]
  records       Json
  /// After this the undo is gone; the playbook's window is 7 days.
  rollbackUntil DateTime  @map("rollback_until")
  rolledBackAt  DateTime? @map("rolled_back_at")
  rolledBackBy  String?   @map("rolled_back_by")
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  template ImportTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("import_batches")
}

/// One merge, and everything needed to undo it (playbook-v2 P5/2).
///
/// A merge moves every activity, email, task, document, call and deal off one
/// record onto another and tombstones the loser. That is not a typo-level
/// mistake to make — it is two clients becoming one — so the pre-merge state is
/// stored whole and the operation is reversible for 30 days.
///
/// The snapshot holds BOTH sides: the loser's full row (so it can be restored
/// exactly) and, per relinked table, the ids that moved (so the revert puts
/// back precisely what the merge took and nothing a person has since attached
/// to the survivor).
model MergeRecord {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  /// company | lead
  entity      String
  survivorId  String    @map("survivor_id")
  loserId     String    @map("loser_id")
  /// { loser: {...row}, survivorBefore: {...row}, moved: { activities: [...], ... } }
  snapshot    Json
  /// Field-by-field choices, for the audit trail: which side each value came from.
  choices     Json?
  performedBy String?   @map("performed_by")
  /// After this, the undo is gone and the tombstone is permanent.
  revertUntil DateTime  @map("revert_until")
  revertedAt  DateTime? @map("reverted_at")
  revertedBy  String?   @map("reverted_by")
  at          DateTime  @default(now())

  @@index([workspaceId, at])
  @@index([workspaceId, entity, survivorId])
  @@index([loserId])
  @@map("merge_records")
}

/// An Owner-defined field on a Lead, Company or Deal (playbook-v2 P5/1).
///
/// A DEFINITION REGISTRY plus a typed JSON column, rather than a column per
/// field: a workspace adding a field must not be a migration, and the schema
/// has to stay identical across tenants for the tenant guard and RLS to mean
/// anything.
///
/// Fields are ARCHIVED, never hard-deleted while they hold data. Dropping a
/// definition would leave orphaned values that nothing can read or erase — and
/// an unreadable value someone typed a client's phone number into is a GDPR
/// problem, not a tidiness one.
model CustomFieldDef {
  id          String          @id @default(cuid())
  workspaceId String          @map("workspace_id")
  /// lead | company | deal
  entity      String
  /// Stable slug, and the key inside the entity's customFields object. Renaming
  /// the LABEL must never orphan the values, so the key never changes.
  key         String
  label       String
  type        CustomFieldType
  /// [{ value, label }] for SELECT / MULTISELECT; empty otherwise.
  options     Json            @default("[]")
  required    Boolean         @default(false)
  archived    Boolean         @default(false)
  position    Int             @default(0)
  /// Shown under the input. Optional, and the only free text a definition has.
  help        String?
  createdBy   String?         @map("created_by")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@unique([workspaceId, entity, key])
  @@index([workspaceId, entity, position])
  @@map("custom_field_defs")
}

/// A named filter set + column selection + sort over a list surface
/// (playbook-v2 P3/2). Rendered as the tabs above the leads table.
model SavedView {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  name        String
  /// Which list this view is over. "lead" is the only one today; deals and
  /// companies get their own tabs in P4/P5 without a schema change.
  entity      String   @default("lead")
  /// The creator. Kept even on a shared view so the tab can say whose it is,
  /// and so "my views" survives sharing.
  ownerId     String   @map("owner_id")
  /// false = personal (only ownerId sees it); true = workspace-shared.
  /// Not a grant: sharing a saved filter reveals nothing the viewer could not
  /// already filter for themselves inside their own workspace.
  shared      Boolean  @default(false)
  /// FilterSet — { match, conditions[] }. Json rather than columns because the
  /// condition list is variable-length; validated with zod on the way in, so a
  /// hand-edited row cannot reach the evaluator.
  filters     Json     @default("{}")
  /// Ordered column keys. Empty means "the default column set".
  columns     Json     @default("[]")
  /// { field, direction } — null means the default sort.
  sort        Json?
  /// Tab order within the workspace, lowest first.
  position    Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  /// Two views with the same name in one workspace are a UI bug, not a feature.
  @@unique([workspaceId, entity, ownerId, name])
  /// The tab strip reads by workspace + entity on every page load.
  @@index([workspaceId, entity, position])
  /// A person's own views, for the personal/shared split.
  @@index([workspaceId, ownerId])
  @@map("saved_views")
}

/// One visitor's session on one public page (playbook-v3 P8/a).
///
/// No cookie is set anywhere in this feature: continuity within a session comes
/// from a random token in sessionStorage, which is why the tracked pages carry
/// a notice line and not a consent banner. The reasoning is written out in
/// src/modules/tracking/README-ish comments for counsel review.
model PageVisit {
  id          String  @id @default(cuid())
  workspaceId String  @map("workspace_id")
  /// audit_share | quote | booking | public_audit
  pageType    String  @map("page_type")
  pageSlug    String  @map("page_slug")
  /// Who the page was made FOR, when it was made for someone. This is what
  /// makes "did the recipient open the quote?" answerable at all.
  leadId      String? @map("lead_id")
  companyId   String? @map("company_id")
  documentId  String? @map("document_id")
  auditId     String? @map("audit_id")

  /// sessionStorage token — distinct sessions, no cross-site identity.
  sessionToken String   @map("session_token")
  referrer     String?
  /// mobile | desktop, from the viewport width. Not a fingerprint.
  viewport     String?
  startedAt    DateTime @default(now()) @map("started_at")
  lastSeenAt   DateTime @map("last_seen_at")
  durationMs   Int      @default(0) @map("duration_ms")
  scrollPct    Int      @default(0) @map("scroll_pct")
  /// { "<section name>": milliseconds visible }
  sections     Json     @default("{}")

  /// Salted hash, kept for as long as the visit is. The RAW address lives in
  /// ipRaw for at most 24 hours so the enrichment worker can read it, and the
  /// nightly purge deletes it — enforced by a test.
  ipHash String? @map("ip_hash")
  ipRaw  String? @map("ip_raw")

  /// Enrichment result (P8/b). Never a fact: `confidence` qualifies it and the
  /// UI says "valószínűleg" for anything below high.
  enrichedAt     DateTime? @map("enriched_at")
  orgName        String?   @map("org_name")
  guessCompanyId String?   @map("guess_company_id")
  /// high | medium | low | none
  confidence     String?

  /// The visitor asked not to be tracked (DNT or GPC): a bare view and nothing
  /// else — no duration, no sections, no address, not even a hash.
  doNotTrack Boolean @default(false) @map("do_not_track")

  @@index([workspaceId, pageType, pageSlug])
  @@index([workspaceId, startedAt])
  @@index([workspaceId, sessionToken, pageSlug])
  @@index([leadId])
  @@map("page_visits")
}

/// "Danubia Kft. megnézte az ajánlatot" — an identified company on a page we
/// published (playbook-v3 P8/b).
model VisitorSignal {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  companyId   String   @map("company_id")
  leadId      String?  @map("lead_id")
  visitId     String   @map("visit_id")
  pageType    String   @map("page_type")
  pageSlug    String   @map("page_slug")
  /// high | medium — low and none never become a signal.
  confidence  String
  durationMs  Int      @default(0) @map("duration_ms")
  at          DateTime @default(now())
  /// The lead card shows a warm flag until this moment (7 days).
  warmUntil   DateTime @map("warm_until")

  @@index([workspaceId, at])
  @@index([workspaceId, companyId])
  @@index([leadId])
  @@map("visitor_signals")
}

/// A milestone checklist template (playbook-v3 P11/2a, 2d).
///
/// Versioned like a document template: a project records the version it was
/// created from, so editing the template never rewrites history on projects
/// already running.
model ProjectTemplate {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  name        String
  version     Int       @default(1)
  /// draft | active | archived — same vocabulary as document templates.
  status      String    @default("active")
  /// [{ title, dayOffset, kind }] — kind is "generic" or "certificate".
  milestones  Json      @default("[]")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  projects Project[]

  @@index([workspaceId, status])
  @@map("project_templates")
}

/// Delivery after the deal is won (playbook-v3 P11/2).
///
/// DELIBERATELY SMALL: a checklist with dates, owners and the document chain.
/// No Gantt, no dependencies, no time tracking — the playbook says so and it is
/// right, because the thing that actually goes wrong in a small agency is not
/// scheduling, it is a certificate nobody issued.
model Project {
  id              String    @id @default(cuid())
  workspaceId     String    @map("workspace_id")
  dealId          String    @unique @map("deal_id")
  companyId       String?   @map("company_id")
  leadId          String?   @map("lead_id")
  name            String
  templateId      String?   @map("template_id")
  /// The template VERSION this was built from, so an edited template does not
  /// silently rewrite what a running project agreed to deliver.
  templateVersion Int?      @map("template_version")
  startedAt       DateTime  @default(now()) @map("started_at")
  closedAt        DateTime? @map("closed_at")
  createdBy       String?   @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  template   ProjectTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  milestones Milestone[]

  @@index([workspaceId, closedAt])
  @@map("projects")
}

/// One line of the checklist.
///
/// ── IT HOLDS ALMOST NOTHING ────────────────────────────────────────────────
///
/// The title, the due date, the owner, the note and the done state all live on
/// a Task — "a milestone IS a task under the hood: reuse, don't duplicate".
/// That is not tidiness, it is the feature: a milestone appears in Today Queue,
/// in My Tasks, in the overdue sweep and in the Monday digest without a single
/// line of code teaching those places what a milestone is, and there is exactly
/// ONE done flag, so the two can never disagree.
///
/// What is left here is what a task has no opinion about: where the line sits
/// in the list, and whether it is the certificate one.
model Milestone {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  projectId   String   @map("project_id")
  /// The task that carries everything else. Deleted with the milestone.
  taskId      String   @unique @map("task_id")
  position    Int      @default(0)
  /// generic | certificate
  kind        String   @default("generic")
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([workspaceId, projectId])
  @@map("milestones")
}

/// One firing of a quote-behaviour rule (playbook-v4 P14/3).
///
/// Kept for two reasons. The first is the once-per-quote-per-rule guarantee:
/// without a record, a daily sweep would raise the same task every day until
/// somebody signed. The second is the point of the whole feature — `acceptedAt`
/// is filled in if the quote is accepted afterwards, so the quarterly review can
/// say which rules actually save quotes instead of which ones fire most.
model QuoteRuleRun {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  documentId  String    @map("document_id")
  ruleId      String    @map("rule_id")
  /// The sentence shown to the operator, kept as it was at firing time.
  reason      String
  taskId      String?   @map("task_id")
  /// The prepared draft, if the rule was configured to write one. A human
  /// reads and sends it — nothing here sends anything.
  draftId     String?   @map("draft_id")
  firedAt     DateTime  @default(now()) @map("fired_at")
  /// Set when the quote was accepted after this fired. Null means it was not
  /// (yet), which is the honest default rather than a zero.
  acceptedAt  DateTime? @map("accepted_at")

  @@unique([documentId, ruleId])
  @@index([workspaceId, firedAt])
  @@map("quote_rule_runs")
}

/// One open or click on a message we sent (playbook-v3 P9/1).
///
/// An open is a SIGNAL, not proof: Apple Mail Privacy Protection pre-fetches
/// images and many clients block them outright, so the count is indicative in
/// both directions. Every surface that shows it says so.
model EmailTrackEvent {
  id          String   @id @default(cuid())
  workspaceId String   @map("workspace_id")
  messageId   String   @map("message_id")
  leadId      String?  @map("lead_id")
  /// open | click
  kind        String
  /// The link that was followed, for a click.
  url         String?  @db.Text
  at          DateTime @default(now())

  message EmailMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([workspaceId, messageId])
  @@index([leadId])
  @@map("email_track_events")
}

/// A sector-wide digital state report (playbook-v4 P12/2).
///
/// The lead magnet and the PR engine — and, deliberately, the data-collection
/// engine for the P15 digital index: every site it audits lands in the same
/// AuditResult store as everything else.
///
/// ── THE OUTPUT NAMES NOBODY ────────────────────────────────────────────────
///
/// `stats` holds counts, medians and percentages. No company name, domain or
/// URL is ever written into it, and a test asserts that on the rendered
/// artifact: a report that identifies the businesses it measured is not a
/// report, it is a list, and publishing one would end the goodwill this is
/// meant to build.
model SectorReport {
  id           String    @id @default(cuid())
  workspaceId  String    @map("workspace_id")
  /// What was searched for, e.g. "fogorvos".
  sector       String
  /// Where, e.g. "Budapest".
  location     String
  title        String
  /// draft | running | ready | published
  status       String    @default("draft")
  /// Public slug, set on publish.
  slug         String?   @unique
  /// How many sites the batch was allowed to audit.
  cap          Int       @default(60)
  /// Businesses the search found.
  foundCount   Int       @default(0)
  /// …of which these had a site we could actually measure.
  auditedCount Int       @default(0)
  /// Deterministic aggregates. Never anything that names a company.
  stats        Json?
  /// The prose between the numbers — one Sonnet call, Owner-edited.
  narrative    Json?
  pdfPath      String?   @map("pdf_path")
  /// What the batch cost, so a second one is a decision with a number on it.
  costUsd      Decimal   @default(0) @map("cost_usd")
  publishedAt  DateTime? @map("published_at")
  createdBy    String?   @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  downloads SectorReportDownload[]

  @@index([workspaceId, status])
  @@map("sector_reports")
}

/// Someone who asked for a sector report (playbook-v4 P12/2c).
///
/// The same dual-consent shape as the self-serve audit: a required box to
/// deliver the file, and a separate, unchecked marketing box that is the only
/// lawful basis for writing to them afterwards.
model SectorReportDownload {
  id                 String    @id @default(cuid())
  workspaceId        String    @map("workspace_id")
  reportId           String    @map("report_id")
  name               String
  email              String
  companyName        String?   @map("company_name")
  serviceConsent     Boolean   @default(true) @map("service_consent")
  marketingConsent   Boolean   @default(false) @map("marketing_consent")
  consentTextVersion String    @map("consent_text_version")
  ip                 String?
  userAgent          String?   @map("user_agent")
  leadId             String?   @map("lead_id")
  sentAt             DateTime? @map("sent_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  report SectorReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([workspaceId, reportId])
  @@map("sector_report_downloads")
}

/// A referral asked for after a job was delivered (playbook-v4 P13/3).
///
/// Timing is the whole feature: fourteen days after a client confirms the work
/// is done is the satisfaction peak, and a month later it is an awkward
/// request. The job drafts and reminds; a person reads and sends.
model ReferralRequest {
  id          String    @id @default(cuid())
  workspaceId String    @map("workspace_id")
  /// The certificate whose acknowledgement started the clock.
  documentId  String    @unique @map("document_id")
  leadId      String?   @map("lead_id")
  companyId   String?   @map("company_id")
  /// The prepared draft. A person sends it, or does not.
  messageId   String?   @map("message_id")
  taskId      String?   @map("task_id")
  /// drafted | sent | responded | produced
  status      String    @default("drafted")
  /// Set when this request led to a referral we can point at.
  referrerId  String?   @map("referrer_id")
  respondedAt DateTime? @map("responded_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([workspaceId, status])
  @@index([workspaceId, companyId, createdAt])
  @@map("referral_requests")
}
